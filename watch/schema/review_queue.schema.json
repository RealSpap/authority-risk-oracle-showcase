{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "watch/review_queue.json v1",
 "type": "object",
 "required": [
  "generated_utc",
  "total",
  "by_priority",
  "items"
 ],
 "properties": {
  "generated_utc": {
   "type": "string"
  },
  "total": {
   "type": "integer"
  },
  "by_priority": {
   "type": "object"
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "priority",
     "kind",
     "text",
     "todo",
     "source"
    ],
    "properties": {
     "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
     },
     "kind": {
      "type": "string"
     },
     "chain": {
      "type": [
       "string",
       "null"
      ]
     },
     "target": {
      "type": [
       "string",
       "null"
      ]
     },
     "text": {
      "type": "string"
     },
     "todo": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "first_seen": {
      "type": "string"
     },
     "age_days": {
      "type": "number"
     },
     "overdue": {
      "type": "boolean"
     }
    }
   }
  },
  "overdue": {
   "type": "integer"
  },
  "overdue_days": {
   "type": "number"
  },
  "oldest_days": {
   "type": "number"
  }
 }
}